# Modelo do .env de producao (copie para deploy/.env no checkout da VPS e
# preencha). NUNCA commitar o .env de verdade (ja esta no .gitignore).

SISLANCA_BASE_URL=https://sislanca.fazenda.df.gov.br

# SEMPRE true aqui. O default do codigo e False, pensado para depurar
# visivel na maquina de quem desenvolve -- num servidor Linux sem tela isso
# quebra o Chromium na hora de abrir (mesma pegadinha do Cadastro PP,
# ver scripts/legado em sistema-cadastro-pp).
SISLANCA_HEADLESS=true
