{
  // Flask, reportlab, requests e playwright moram no .venv deste projeto, não no
  // Python global. Sem esta linha o Pylance analisa com o interpretador global e
  // acusa "Import could not be resolved" em imports que funcionam.
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.terminal.activateEnvironment": true,
  // O .env deste projeto vale também para o terminal integrado. Sem esta linha
  // o VS Code avisa que existe arquivo de ambiente configurado e ignorado — e
  // o aviso está certo: rodar o programa pelo terminal usaria o .env (porque o
  // proprio codigo chama load_dotenv), mas um `python -c` solto, nao.
  "python.envFile": "${workspaceFolder}/.env",
  "python.terminal.useEnvFile": true
}
